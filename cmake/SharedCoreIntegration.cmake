include_guard(GLOBAL)
set(RECOMP_SHARED_CORE_ROOT "" CACHE PATH "Optional shared core checkout root")
if(NOT RECOMP_SHARED_CORE_ROOT)
  get_filename_component(_shared_core_default "${CMAKE_CURRENT_LIST_DIR}/../external/shared-cores" ABSOLUTE)
  set(RECOMP_SHARED_CORE_ROOT "${_shared_core_default}" CACHE PATH "Optional shared core checkout root" FORCE)
endif()
function(psx_shared_core component)
  if(NOT EXISTS "${RECOMP_SHARED_CORE_ROOT}/${component}/CMakeLists.txt")
    message(FATAL_ERROR "Missing shared component: ${component}")
  endif()
  set(BUILD_TESTING OFF)
  set(RECOMP_AUDIO_BUILD_TESTS OFF)
  set(RECOMP_INPUT_BUILD_TESTS OFF)
  set(SEGA_PSG_BUILD_TESTS OFF)
  add_subdirectory("${RECOMP_SHARED_CORE_ROOT}/${component}"
    "${CMAKE_BINARY_DIR}/shared-cores/${component}" EXCLUDE_FROM_ALL)
  if(component STREQUAL "mips-recomp-core"
     AND NOT EXISTS "${RECOMP_SHARED_CORE_ROOT}/${component}/include/mips_recomp/decoder.h")
    # The pinned provider exports a flat header whose name also belongs to the
    # PSX image adapter. Keep the namespaced consumer include unambiguous.
    set(_decoder "${RECOMP_SHARED_CORE_ROOT}/${component}/include/mips_decoder.h")
    if(NOT EXISTS "${_decoder}")
      message(FATAL_ERROR "Missing shared MIPS decoder header: ${_decoder}")
    endif()
    file(TO_CMAKE_PATH "${_decoder}" _decoder)
    set(_headers "${CMAKE_BINARY_DIR}/shared-headers")
    file(CONFIGURE OUTPUT "${_headers}/mips_recomp/decoder.h" CONTENT
      "#pragma once\n#include \"@_decoder@\"\n" @ONLY)
    target_include_directories(mips_recomp_core PUBLIC "${_headers}")
  endif()
endfunction()
if(NOT TARGET mips-recomp-core::core)
  psx_shared_core(mips-recomp-core)
endif()

if(NOT TARGET recomp-audio::core)
  psx_shared_core(recomp-audio-core)
endif()
if(NOT TARGET recomp-persistence-core::core)
  psx_shared_core(recomp-persistence-core)
endif()

if(NOT TARGET recomp-input::core)
  psx_shared_core(recomp-input-core)
endif()

if(NOT TARGET retro-runtime::presentation)
  psx_shared_core(recomp-presentation-core)
endif()

if(NOT TARGET recomp-diagnostics-core::core)
  psx_shared_core(recomp-diagnostics-core)
endif()

if(NOT TARGET recomp-mod-core::core)
  psx_shared_core(recomp-mod-core)
endif()
