include_guard(GLOBAL)
option(PSX_NATIVE_OPENBIOS_READ "Use the native OpenBIOS blocking read job in ENHANCED builds" ON)

function(psxrecomp_openbios_read_job target)
    get_target_property(_profile ${target} PSX_EXECUTION_PROFILE)
    if(NOT PSX_NATIVE_OPENBIOS_READ OR NOT _profile STREQUAL "ENHANCED")
        return()
    endif()
    get_target_property(_sources ${target} SOURCES)
    set(_selected "")
    set(_found FALSE)
    foreach(_source IN LISTS _sources)
        get_filename_component(_name "${_source}" NAME)
        if(NOT _name STREQUAL "OpenBIOS_full.c")
            list(APPEND _selected "${_source}")
            continue()
        endif()
        if(_found)
            message(FATAL_ERROR "Duplicate OpenBIOS body for ${target}")
        endif()
        set(_found TRUE)
        file(READ "${_source}" _body)
        if(NOT _body MATCHES "BIOS SHA256: fabe498fbf224e4721f12f31b6f5fe0659205e341dc4e5c5f91b9bd1a1011c57")
            message(FATAL_ERROR "Native OpenBIOS read requires the audited BIOS image")
        endif()
        set(_definition "void OpenBIOS_func_1FC03A78(CPUState* cpu) {")
        string(REGEX MATCHALL "void OpenBIOS_func_1FC03A78\\(CPUState\\* cpu\\) \\{" _matches "${_body}")
        list(LENGTH _matches _count)
        if(NOT _count EQUAL 1)
            message(FATAL_ERROR "Native OpenBIOS read requires exactly one generated read body")
        endif()
        # Rename the definition ONLY. Continuation wrappers and direct callers
        # must still enter the selected native function, not the LLE body.
        string(REPLACE "${_definition}" "void psx_lle_OpenBIOS_func_1FC03A78(CPUState* cpu) {" _body "${_body}")
        set(_output "${CMAKE_CURRENT_BINARY_DIR}/psx_execution/${target}/OpenBIOS_read_selected.c")
        file(CONFIGURE OUTPUT "${_output}" CONTENT "@_body@" @ONLY)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_source}")
        list(APPEND _selected "${_output}")
        set(_original "${_source}")
    endforeach()
    if(NOT _found)
        # Retail-BIOS-only targets have no OpenBIOS request to replace.
        return()
    endif()
    set_property(TARGET ${target} PROPERTY SOURCES "${_selected}")
    psxrecomp_add_implementation(${target}
        NAME openbios-block-read CONTRACT openbios-cd-request-v1
        HLE_SOURCES "${PSXRECOMP_ROOT}/runtime/src/openbios_read_job.c"
        LLE_SOURCES "${_original}"
        CONTRACT_FILES "${_original}" "${CMAKE_CURRENT_FUNCTION_LIST_FILE}")
    message(STATUS "psxrecomp: native resumable OpenBIOS read job selected for ${target}")
endfunction()
