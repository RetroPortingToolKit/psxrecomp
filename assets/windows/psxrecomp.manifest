<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Application manifest embedded in every shipped psxrecomp executable
  (cmake/psx_windows_manifest.cmake).

  activeCodePage=UTF-8 makes the process ANSI code page UTF-8 on Windows 10
  1903 and later: every narrow Win32 call (CreateFileA, FindFirstFileA,
  CreateProcessA, ...), the CRT's fopen and argv then speak the same UTF-8
  that SDL, tinyfiledialogs, TOML files, our string literals and libstdc++'s
  std::filesystem already use. Without it those calls decode bytes in the
  legacy system code page (CP932 on Japanese Windows), which garbles UI text
  and breaks non-ASCII paths (psxrecomp issue #371). Older Windows ignores
  the element; runtime/include/psx_win_utf8.h keeps dialog text correct there.

  The trustInfo and compatibility sections restate what the MinGW toolchain's
  default manifest supplies, because an embedded manifest replaces it.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows Vista -->
      <supportedOS Id="{e2011457-1546-43c5-a5fe-008deee3d3f0}"/>
      <!-- Windows 7 -->
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/>
      <!-- Windows 8 -->
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/>
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
      <!-- Windows 10 / 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
